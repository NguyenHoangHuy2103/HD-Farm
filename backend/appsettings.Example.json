{
  "ConnectionStrings": {
    "Default": "Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<your-password>"
  },
  "Jwt": {
    "Issuer": "hdfarm-api",
    "Audience": "hdfarm-clients",
    "SecretKey": "<generate-a-long-random-string>",
    "ExpiryMinutes": 60
  },
  "EInvoice": {
    "Provider": "viettel | vnpt | misa | fpt",
    "ApiBaseUrl": "<provider-api-base-url>",
    "ApiKey": "<provider-api-key>"
  },
  "Payment": {
    "VnPay": {
      "TmnCode": "<vnpay-tmn-code>",
      "HashSecret": "<vnpay-hash-secret>"
    }
  }
}
